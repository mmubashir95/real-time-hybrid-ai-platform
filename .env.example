OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=512
OPENAI_REASONING_EFFORT=minimal
OPENAI_MAX_CONCURRENT_REQUESTS=2
RAG_MAX_CONTEXT_TOKENS=6000
RAG_MAX_GENERATION_INPUT_TOKENS=8000
# Explicitly list which authorized visibility classes may leave the backend.
RAG_EXTERNAL_ALLOWED_VISIBILITIES=public
MODEL_TIMEOUT_SECONDS=30
DATABASE_URL=postgresql+asyncpg://localhost:5432/realtime_ai
# Optional: must point to a disposable pgvector-enabled database for integration tests.
TEST_DATABASE_URL=postgresql+asyncpg://localhost:5432/realtime_ai_test
